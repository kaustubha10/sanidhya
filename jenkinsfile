pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '392211784456'
        ECR_REPOSITORY = 'sanidhya-ecr'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE = "kaustubh10k/sanidhya"
        ECR_IMAGE = "${ECR_REGISTRY}/${ECR_REPOSITORY}"
    }

    options {
        buildDiscarder(
            logRotator(
                numToKeepStr: '5',
                artifactNumToKeepStr: '5'
            )
        )

        timestamps()
    }

    tools {
        maven 'maven_3.9.16'
    }

    stages {

        /*
         * =========================
         * 1. CODE CHECKOUT
         * =========================
         */

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'

                checkout scm

                echo 'Source code checkout completed'
            }
        }


        /*
         * =========================
         * 2. CODE COMPILATION
         * =========================
         */

        stage('Code Compilation') {
            steps {
                echo 'Code compilation is starting...'

                sh 'mvn clean compile'

                echo 'Code compilation is completed'
            }
        }


        /*
         * =========================
         * 3. JUNIT TEST
         * =========================
         */

        stage('JUnit Test') {
            steps {
                echo 'JUnit test execution is starting...'

                sh 'mvn test'

                echo 'JUnit test execution is completed'
            }

            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }


        /*
         * =========================
         * 4. SONARQUBE ANALYSIS
         * =========================
         */

        stage('SonarQube Analysis') {
            steps {
                echo 'SonarQube analysis is starting...'

                withSonarQubeEnv('sonar-server') {
                    sh 'mvn sonar:sonar'
                }

                echo 'SonarQube analysis completed'
            }
        }


        /*
         * =========================
         * 5. QUALITY GATE
         * =========================
         */

        stage('Quality Gate') {
            steps {
                echo 'Waiting for SonarQube Quality Gate...'

                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }

                echo 'SonarQube Quality Gate passed'
            }
        }


        /*
         * =========================
         * 6. PACKAGE APPLICATION
         * =========================
         */

        stage('Code Package') {
            steps {
                echo 'Code packaging is starting...'

                sh 'mvn package -DskipTests'

                echo 'Code packaging is completed'
            }
        }


        /*
         * =========================
         * 7. BUILD DOCKER IMAGE
         * =========================
         */

        stage('Build Docker Image') {
            steps {
                echo 'Starting Docker image build...'

                sh '''
                    docker build \
                        -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                        -t ${DOCKER_IMAGE}:latest \
                        .
                '''

                echo 'Docker image build completed'
            }
        }


        /*
         * =========================
         * 8. DOCKER HUB LOGIN
         * =========================
         */

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'dockerhubCred',
                        variable: 'DOCKERHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "${DOCKERHUB_TOKEN}" | \
                        docker login \
                        --username kaustubh10k \
                        --password-stdin
                    '''
                }

                echo 'Docker Hub login completed'
            }
        }


        /*
         * =========================
         * 9. PUSH TO DOCKER HUB
         * =========================
         */

        stage('Push to Docker Hub') {
            steps {
                echo 'Pushing Docker image to Docker Hub...'

                sh '''
                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                '''

                echo 'Docker Hub push completed'
            }
        }


        /*
         * =========================
         * 10. AWS ECR LOGIN
         * =========================
         */

        stage('Login to Amazon ECR') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr-credentials']
                ]) {

                    sh '''
                        aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                        docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                    '''
                }

                echo 'ECR login completed'
            }
        }


        /*
         * =========================
         * 11. TAG IMAGE FOR ECR
         * =========================
         */

        stage('Tag Image for ECR') {
            steps {
                echo 'Tagging Docker image for ECR...'

                sh '''
                    docker tag \
                        ${DOCKER_IMAGE}:latest \
                        ${ECR_IMAGE}:latest

                    docker tag \
                        ${DOCKER_IMAGE}:${IMAGE_TAG} \
                        ${ECR_IMAGE}:${IMAGE_TAG}
                '''

                echo 'ECR tagging completed'
            }
        }


        /*
         * =========================
         * 12. PUSH IMAGE TO ECR
         * =========================
         */

        stage('Push Image to ECR') {
            steps {
                echo 'Pushing Docker image to ECR...'

                sh '''
                    docker push ${ECR_IMAGE}:latest
                    docker push ${ECR_IMAGE}:${IMAGE_TAG}
                '''

                echo 'ECR push completed'
            }
        }
    }


    /*
     * =========================
     * POST BUILD
     * =========================
     */

    post {

        always {
            echo 'Cleaning up Docker credentials...'

            sh '''
                docker logout ${ECR_REGISTRY} || true
                docker logout || true
            '''
        }

        success {
            echo '=========================================='
            echo 'PIPELINE COMPLETED SUCCESSFULLY'
            echo '=========================================='

            echo "Docker Hub Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
            echo "Docker Hub Latest: ${DOCKER_IMAGE}:latest"

            echo "ECR Image: ${ECR_IMAGE}:${IMAGE_TAG}"
            echo "ECR Latest: ${ECR_IMAGE}:latest"
        }

        failure {
            echo '=========================================='
            echo 'PIPELINE FAILED'
            echo '=========================================='
        }
    }
}